# Variables de entorno para podman-compose. Copiar este archivo a .env y
# completar los valores. El .env real nunca se versiona (ver .gitignore).

# Clave de aplicacion de Laravel. Generarla con:
#   podman-compose exec -T backend php artisan key:generate --show
# o localmente con: php artisan key:generate --show
APP_KEY=

# Base de datos MySQL 8.4 LTS
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root
DB_PORT=3306

# Origen de la SPA autorizado a llamar a la API con la cookie de sesion. La SPA
# se autentica por cookie (no por token), asi que el backend debe responder con
# credenciales a este origen exacto: es el valor que leen backend/config/cors.php
# (allowed_origins) y el que debe estar tambien en SANCTUM_STATEFUL_DOMAINS.
# En desarrollo coincide con el puerto de `ng serve`.
FRONTEND_URL=http://localhost:4200
